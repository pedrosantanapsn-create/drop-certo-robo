{
  "manifest_version": 3,
  "name": "Drop Certo - Ajudante",
  "version": "1.1.0",
  "description": "Ajudante do robô Drop Certo: gera o seu meli.la e faz buscas na Terabyte e na Amazon pelo seu navegador.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://produto.mercadolivre.com.br/*",
    "https://www.terabyteshop.com.br/*",
    "https://www.amazon.com.br/*",
    "https://euctzxrnxeizgtnmlesn.supabase.co/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "action": {
    "default_title": "Drop Certo - Ajudante",
    "default_popup": "painel.html"
  }
}