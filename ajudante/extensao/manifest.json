{
  "manifest_version": 3,
  "name": "Drop Certo - Ajudante",
  "version": "1.0.0",
  "description": "Gera o seu link meli.la (afiliados do Mercado Livre) para os produtos que o robô Drop Certo pedir.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://produto.mercadolivre.com.br/*",
    "https://euctzxrnxeizgtnmlesn.supabase.co/*"
  ],
  "background": { "service_worker": "fundo.js" },
  "action": { "default_title": "Drop Certo - Ajudante", "default_popup": "painel.html" }
}
