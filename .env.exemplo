# Copie este arquivo com o nome .env (só para rodar no seu PC).
# NUNCA envie o .env para o GitHub — lá as chaves ficam em "Secrets".

TELEGRAM_TOKEN=cole_aqui_o_token_do_BotFather
ADMIN_CHAT_ID=seu_id_do_telegram
CANAL_ID=@seu_canal_publico
GEMINI_API_KEY=sua_chave_do_AI_Studio

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sua_chave_service_role
SUPABASE_TABELA=produtos
SUPABASE_BUCKET=imagens

# Nomes das colunas da tabela do site (confira com o comando /colunas)
COL_NOME=nome
COL_PRECO=preco
COL_IMAGEM=imagem_url
COL_LINK=link
COL_DESCRICAO=descricao
